diff --git a/tests/test_export_web.py b/tests/test_export_web.py
new file mode 100644
index 0000000..5023a55
--- /dev/null
+++ b/tests/test_export_web.py
@@ -0,0 +1,100 @@
+"""Read-only web export for the V5 website: NFL only, whitelisted fields, values copied unchanged, hash, never overwritten."""
+import gzip
+import hashlib
+import json
+import sqlite3
+from datetime import datetime, timezone
+
+import pytest
+
+from arbsims import export_web as WX
+from tests.conftest import NEEDS_DATA
+
+
+def _db_path(con):
+    return next(r[2] for r in con.execute("PRAGMA database_list") if r[1] == "main")
+
+
+@pytest.fixture(scope="module")
+def stored(con, tmp_path_factory):
+    """An official 1,000-simulation NFL forecast and a stored Sunday report built from it (fake odds, no provider call)."""
+    from arbsims import config, forecast
+    from arbsims.edge import engine as E, report as R
+    mp = pytest.MonkeyPatch()
+    mp.setattr(config, "DATA_DIR", tmp_path_factory.mktemp("wx"))
+    gid = con.execute("SELECT game_id FROM games WHERE league='NFL' AND season=2026 AND week=9 ORDER BY kickoff_utc LIMIT 1").fetchone()[0]
+    r = forecast.run(con, gid, n_sims=1000, workers=1, kind="pregame", reason="web export test")
+    forecast.designate(con, gid, r["forecast_id"], reason="web export test", by="test")
+    fc = forecast.load(con, r["forecast_id"])
+    p = next(iter(fc["payload"]["players"].values()))
+    st = next(iter(p["stats"]))
+    row = {"player_name": p["name"], "team": p["team"], "opponent": "X", "market_label": "Test", "stat": st, "side": "over",
+           "book_title": "FanDuel", "line": 10.5, "price": -110, "p_win": 0.55, "p_cal": None, "cal_roi_pct": None,
+           "roi_pct": 5.0, "quality": "valid", "flags": [], "forecast_id": fc["id"], "model_version": fc["model_version"],
+           "internal_note": "must not be exported"}
+    rep = {"meta": {**R.build(con, R.sunday_of(datetime.now(timezone.utc)))["meta"], "games_with_odds": 1},
+           "rows": [row], "top": [dict(row, rank=1)]}
+    rep["top"] = [rep["rows"][0]]
+    rep["rows"][0]["rank"] = 1
+    rid = R.store(con, rep, "revision")       # the session database may already hold this Sunday's "published" report
+    yield gid, fc, rid
+    mp.undo()
+
+
+@NEEDS_DATA
+def test_read_only_connection_cannot_write(con, stored):
+    ro = WX.connect_ro(_db_path(con))
+    with pytest.raises(sqlite3.OperationalError):
+        ro.execute("CREATE TABLE x(a)")
+
+
+@NEEDS_DATA
+def test_projections_copy_the_official_forecast_and_nothing_else(con, stored, tmp_path):
+    gid, fc, _ = stored
+    ro = WX.connect_ro(_db_path(con))
+    doc, tag = WX.build("projections", ro, season=2026, week=9)
+    games = doc["body"]["games"]
+    assert {g["game_id"][:7] for g in games} == {"2026_09"} and all(not g["game_id"].startswith("CFB") for g in games)
+    g = next(x for x in games if x["game_id"] == gid)
+    assert g["forecast_status"] == "official" and g["forecast_id"] == fc["id"] and g["payload_sha256"] == fc["payload_sha256"]
+    assert g["game"]["win_prob"] == fc["summary"]["win_prob"] and g["representative"]["score"] == fc["payload"]["representative"]["score"]
+    pid, e = next(iter(fc["payload"]["players"].items()))
+    pl = next(x for x in g["players"] if x["player_id"] == pid)
+    st = next(iter(e["stats"]))
+    assert pl["stats"][st]["mean"] == e["stats"][st]["mean"] and pl["stats"][st]["median"] == e["stats"][st]["p50"]
+    assert pl["stats"][st]["dist"]["n"] == sum(c for _, c in e["counts"][st])
+    text = json.dumps(doc)
+    assert '"seed"' not in text and '"inputs"' not in text                   # internals are never exported
+    others = [x for x in games if x["game_id"] != gid]
+    assert others and all(x["forecast_status"] == "no_official_forecast" and "players" not in x for x in others)
+
+
+@NEEDS_DATA
+def test_edges_export_is_the_stored_report_with_whitelisted_fields(con, stored, tmp_path):
+    _, fc, rid = stored
+    doc, tag = WX.build("edges", WX.connect_ro(_db_path(con)), season=2026)
+    b = doc["body"]
+    assert b["meta"]["report_id"] == rid and b["meta"]["kind"] == "revision" and b["meta"]["rows_sha256"]
+    assert b["top_row_ids"] == b["row_ids"][:1] and b["rows"][0]["cal_roi_pct"] is None      # missing stays missing
+    assert "internal_note" not in b["rows"][0] and b["rows"][0]["model_version"] == fc["model_version"]
+
+
+@NEEDS_DATA
+def test_hash_and_files_are_never_overwritten(con, stored, tmp_path):
+    doc, tag = WX.build("projections", WX.connect_ro(_db_path(con)), season=2026, week=9,
+                        now=datetime(2026, 10, 31, 1, 0, tzinfo=timezone.utc))
+    path = WX.write(doc, tag, tmp_path)
+    assert path.name == "sims_nfl_projections_2026w09_20261031T010000Z.json.gz"
+    back = json.load(gzip.open(path, "rt"))
+    assert back["payload_sha256"] == hashlib.sha256(WX._canon(back["body"]).encode()).hexdigest()
+    assert back["format"] == WX.FORMAT and back["league"] == "NFL"
+    with pytest.raises(FileExistsError):
+        WX.write(doc, tag, tmp_path)
+
+
+@NEEDS_DATA
+def test_history_export_copies_the_graded_record(con, stored):
+    doc, _ = WX.build("history", WX.connect_ro(_db_path(con)), season=2026)
+    h = doc["body"]
+    decided = [r for r in h["top5_records"] if r["result"] in ("win", "loss", "push")]
+    assert h["top5"]["overall"]["n"] == len(decided) and "warning" in h["top5"] and "records" not in h["top5"]
