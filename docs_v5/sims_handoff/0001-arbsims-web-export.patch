diff --git a/arbsims/export_web.py b/arbsims/export_web.py
new file mode 100644
index 0000000..9dc75c9
--- /dev/null
+++ b/arbsims/export_web.py
@@ -0,0 +1,164 @@
+"""Read-only, versioned web export of existing SIMS outputs (NFL only) for the ArbitrEdge V5 website.
+
+    arbsims web-export projections --week 9 --out DIR     official forecasts of the week's NFL games
+    arbsims web-export edges [--slate YYYY-MM-DD] --out DIR  the latest stored Sunday Top 5 report (published/revision)
+    arbsims web-export history --out DIR                  graded Top 5 history and the forecast accuracy summary
+
+The database is opened read-only (SQLite ``mode=ro``): nothing is simulated, graded, collected or written. Values are
+copied from what SIMS already stored (official forecasts, immutable edge reports, grades); nothing is recomputed or
+filled in, and a missing value stays ``null``. College games and college props are never exported. Each file is
+``sims_nfl_<kind>_<tag>_<UTC>.json.gz`` with ``payload_sha256`` over the canonical JSON of ``body``; files are never
+overwritten.
+"""
+from __future__ import annotations
+
+import gzip
+import hashlib
+import json
+import os
+import sqlite3
+from datetime import datetime, timezone
+from pathlib import Path
+
+FORMAT = "arbsims-web-export"
+SCHEMA_VERSION = 1
+KINDS = ("projections", "edges", "history")
+MAX_EXACT_TALLY = 60          # distributions with more distinct values are exported as 30-bin histograms
+
+GAME_KEYS = ("game_id", "season", "week", "home", "away", "kickoff_utc", "venue", "win_prob", "favorite", "mean_score",
+             "median_score", "margin_home", "total", "rep_score", "n_sims")
+PLAYER_STAT_KEYS = ("mean", "sd", "p10", "p25", "p50", "p75", "p90")
+OFFER_EXTRA_KEYS = ("p_loss", "p_push", "valid_count", "forecast_id", "model_version", "player_id", "slate_game", "ev_per_100")
+
+
+def connect_ro(path: str | os.PathLike | None = None) -> sqlite3.Connection:
+    from . import config
+    p = Path(path or config.DB_PATH)
+    if not p.exists():
+        raise FileNotFoundError(f"SIMS database not found: {p}")
+    con = sqlite3.connect(f"file:{p}?mode=ro", uri=True)
+    con.row_factory = sqlite3.Row
+    return con
+
+
+def _canon(body) -> str:
+    return json.dumps(body, sort_keys=True, separators=(",", ":"), default=str)
+
+
+def _compact(counts: list) -> dict:
+    """The stored value -> count tally, exact when small, otherwise a 30-bin histogram (counts only, no smoothing)."""
+    n = sum(c for _, c in counts)
+    if len(counts) <= MAX_EXACT_TALLY:
+        return {"type": "exact", "n": n, "values": [[v, c] for v, c in counts]}
+    lo, hi = min(v for v, _ in counts), max(v for v, _ in counts)
+    width = (hi - lo) / 30 or 1
+    bins = [0] * 30
+    for v, c in counts:
+        bins[min(29, int((v - lo) / width))] += c
+    return {"type": "hist30", "n": n, "lo": lo, "hi": hi, "counts": bins}
+
+
+def projections(con, season: int, week: int) -> dict:
+    from . import forecast
+    games = []
+    for g in con.execute("SELECT * FROM games WHERE league='NFL' AND season=? AND week=? ORDER BY kickoff_utc, game_id",
+                         (season, week)).fetchall():
+        g = dict(g)
+        o = forecast.official(con, g["game_id"])
+        base = {"game_id": g["game_id"], "home": g["home"], "away": g["away"], "kickoff_utc": g["kickoff_utc"],
+                "status": g.get("status")}
+        if not o:
+            games.append({**base, "forecast_status": "no_official_forecast"})
+            continue
+        fc = forecast.load(con, o["id"])
+        if not fc["integrity_ok"]:
+            games.append({**base, "forecast_status": "integrity_failed", "forecast_id": fc["id"]})
+            continue
+        s, p = fc["summary"], fc["payload"]
+        rep = p.get("representative") or {}
+        players = []
+        for pid, e in p["players"].items():
+            players.append({"player_id": pid, "name": e["name"], "team": e["team"], "pos": e["pos"], "role": e["role"],
+                            "play_prob": e.get("play_prob"), "anytime_td": e.get("anytime_td"),
+                            "stats": {st: {**{k: d.get(k) for k in PLAYER_STAT_KEYS},
+                                           "median": d.get("p50"), "dist": _compact(e["counts"][st])}
+                                      for st, d in e["stats"].items()}})
+        games.append({**base, "forecast_status": "official", "forecast_id": fc["id"], "revision": fc["revision"],
+                      "forecast_created_at": fc["created_at"], "model_version": fc["model_version"],
+                      "model_fingerprint": fc["model_fingerprint"], "n_sims": fc["n_sims"],
+                      "payload_sha256": fc["payload_sha256"],
+                      "game": {k: s.get(k) for k in GAME_KEYS},
+                      "representative": {"score": rep.get("score"), "basis": rep.get("basis"),
+                                         "is_modal_score": rep.get("is_modal_score"),
+                                         "modal_score": (rep.get("score_frequencies") or {}).get("modal_score"),
+                                         "box": rep.get("box")},
+                      "players": players})
+    return {"season": season, "week": week, "games": games}
+
+
+def edges(con, slate: str | None = None) -> dict | None:
+    from .edge import report as R
+    from .edge.page import ROW_KEYS
+    rep = R.latest(con, slate)
+    if rep is None:
+        return None
+    keys = list(ROW_KEYS) + [k for k in OFFER_EXTRA_KEYS if k not in ROW_KEYS]
+    rows = [{k: r.get(k) for k in keys} for r in rep["rows"]]
+    return {"meta": rep["meta"], "rows": rows, "top_row_ids": [r["row_id"] for r in rep["top"]],
+            "row_ids": [r["row_id"] for r in rep["rows"]]}
+
+
+def history(con, season: int) -> dict:
+    from . import grading
+    from .edge import grade as G
+    h = G.history(con)
+    acc = grading.report(con, "NFL", season, None, "pregame", None)
+    return {"top5": {k: v for k, v in h.items() if k != "records"},
+            "top5_records": [{k: r.get(k) for k in ("slate_date", "rank", "player_name", "team", "market_label", "side",
+                                                    "line", "price", "book_title", "p_win", "p_cal", "roi_pct", "cal_roi_pct",
+                                                    "result", "actual", "return_per_100", "clv_pp", "model_version")}
+                             for r in h.get("records", [])],
+            "accuracy_nfl": acc}
+
+
+def build(kind: str, con, *, season: int, week: int | None = None, slate: str | None = None,
+          now: datetime | None = None, fixture: str | None = None) -> tuple[dict, str] | None:
+    """``fixture``: a description of synthetic test inputs; the website shows it as TEST FIXTURE and the V5 importer
+    refuses fixture files in production."""
+    from . import config
+    now = now or datetime.now(timezone.utc)
+    if kind == "projections":
+        if week is None:
+            raise ValueError("projections needs --week")
+        body, tag = projections(con, season, week), f"{season}w{week:02d}"
+    elif kind == "edges":
+        body = edges(con, slate)
+        if body is None:
+            return None
+        m = body["meta"]
+        tag = f"{m['slate_date']}_{m.get('kind', 'report')}{m.get('version', '')}"
+    elif kind == "history":
+        body, tag = history(con, season), f"{season}"
+    else:
+        raise ValueError(kind)
+    doc = {"format": FORMAT, "schema_version": SCHEMA_VERSION, "kind": kind, "league": "NFL",
+           "exported_at": now.isoformat(timespec="seconds"), "sims_model_version": config.MODEL_VERSION,
+           "label": "MODELED: ArbitrEdge SIMS simulation outputs. Probabilities and ROI are model estimates, not "
+                    "guarantees or realized results.",
+           "body": body}
+    if fixture:
+        doc["fixture"] = fixture
+    doc["payload_sha256"] = hashlib.sha256(_canon(body).encode()).hexdigest()
+    return doc, tag
+
+
+def write(doc: dict, tag: str, out_dir: str | os.PathLike) -> Path:
+    out = Path(out_dir)
+    out.mkdir(parents=True, exist_ok=True)
+    stamp = doc["exported_at"].replace("-", "").replace(":", "").replace("+0000", "Z")[:15] + "Z"
+    path = out / f"sims_nfl_{doc['kind']}_{tag}_{stamp}.json.gz"
+    if path.exists():
+        raise FileExistsError(f"{path.name} exists; exports are never overwritten")
+    with gzip.open(path, "wt") as f:
+        json.dump(doc, f, default=str)
+    return path
